{
  "name": "llm-adapter",
  "version": "0.1.0",
  "description": "Provider-agnostic LLM client for Node.js: one API for OpenAI, Anthropic, Gemini, DeepSeek, OpenRouter, Groq, Mistral, xAI and any OpenAI-compatible endpoint.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "sideEffects": [
    "./dist/registry/builtins.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "prepare": "npm run build"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "deepseek",
    "mistral",
    "groq",
    "xai",
    "openrouter",
    "ai",
    "sdk"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/huseyinbozkurt/llm-adapter.git"
  }
}
